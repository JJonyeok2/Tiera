# ---------------------------------------------------------------------------
# 이 파일은 커밋된다. 실제 비밀값은 절대 여기 넣지 말 것.
# 로컬은 .env(.gitignore됨), 배포는 Vercel 프로젝트 환경변수에 넣는다.
# ---------------------------------------------------------------------------

# [로컬] docker compose up -d 로 띄운 Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiera?schema=public"

# [배포] 반드시 pooled 엔드포인트를 쓸 것.
#   Neon     : 호스트에 -pooler 가 붙은 주소
#   Supabase : 6543 포트 (Transaction pooler)
# 서버리스는 람다 인스턴스마다 커넥션을 잡으므로, pooler 없이 붙이면
# 트래픽이 조금만 몰려도 DB 커넥션 상한을 그대로 넘긴다.
# DATABASE_URL="postgresql://...-pooler.../tiera?sslmode=require"

# 마이그레이션 전용(pooler를 통과하지 않는 직결 주소). 없으면 DATABASE_URL을 쓴다.
# DATABASE_URL_UNPOOLED="postgresql://...직결.../tiera?sslmode=require"

# Auth.js — 반드시 새로 생성해서 넣을 것
#   PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#   bash      : openssl rand -base64 32
AUTH_SECRET=""

# 배포 시 필수. 없으면 OAuth 콜백 URL이 어긋난다.
# AUTH_URL="https://<your-domain>"

# OAuth (선택). 둘 다 비우면 프로덕션에는 로그인 수단이 하나도 없다.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 개발용 이메일 로그인. 비밀번호를 검사하지 않는다.
# NODE_ENV=production 이면 코드에서 강제로 꺼지므로 배포 환경에는 넣지 말 것.
ALLOW_DEV_LOGIN="true"

# 일일 랭킹 스냅샷 크론 보호용. Vercel Cron이 이 값을 Bearer로 보내준다.
CRON_SECRET=""
